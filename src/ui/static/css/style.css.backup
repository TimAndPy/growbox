/* GrowBox Control Panel Styles */

:root {
    /* Light Theme Color Palette */
    --primary-green: #52C41A;
    --light-gray: #F5F5F5;
    --white: #FFFFFF;
    --border-gray: #D9D9D9;
    --text-dark: #262626;
    --text-secondary: #8C8C8C;
    --success-green: #52C41A;
    --growth-panel-bg: #F6FFED;
    --growth-panel-border: #B7EB8F;
    --danger-color: #FF4D4F;
    --warning-color: #FAAD14;

    /* Typography Sizes */
    --value-size: 36px;
    --label-size: 14px;
    --heading-size: 20px;
    --body-size: 14px;

    /* Spacing System (8px base) */
    --space-xs: 8px;
    --space-sm: 12px;
    --space-md: 16px;
    --space-lg: 24px;
    --space-xl: 32px;

    /* Font Family */
    --font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: var(--font-family);
    background-color: var(--light-gray);
    color: var(--text-dark);
    line-height: 1.6;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-lg);
    background-color: var(--light-gray);
}

/* Header */
.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-md) var(--space-lg);
    background-color: var(--white);
    border-bottom: 1px solid var(--border-gray);
    margin-bottom: var(--space-lg);
}

.header-left {
    display: flex;
    align-items: center;
    gap: var(--space-md);
}

.logo {
    height: 40px;
    width: auto;
}

.header h1 {
    flex: 1;
    text-align: center;
    font-size: var(--heading-size);
    color: var(--text-dark);
    font-weight: 600;
}

.connection-status {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--label-size);
}

.status-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: var(--danger-color);
}

.status-dot.online {
    background-color: var(--success-green);
}

.status-dot.offline {
    background-color: var(--danger-color);
    animation: pulse 2s infinite;
}

@keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
}

/* Footer */
.footer {
    text-align: center;
    padding: var(--space-md);
    font-size: 12px;
    color: var(--text-secondary);
    border-top: 1px solid var(--border-gray);
    margin-top: var(--space-lg);
    background-color: var(--white);
}

.footer-branding {
    color: var(--text-secondary);
}

/* Section */
.section {
    background-color: var(--white);
    border: 1px solid var(--border-gray);
    border-radius: var(--space-xs);
    padding: var(--space-lg);
    margin-bottom: var(--space-lg);
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}

.section h2 {
    font-size: var(--heading-size);
    margin-bottom: var(--space-md);
    color: var(--text-dark);
    font-weight: 600;
}

/* 2-Column Layout for Controls and Growth Panel */
.panels-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    margin-top: var(--space-lg);
}

/* Growth Phase / Growth Cycle Panel */
.growth-panel {
    background-color: var(--growth-panel-bg);
    border: 1px solid var(--growth-panel-border);
    border-radius: var(--space-xs);
    padding: var(--space-lg);
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}

.growth-phase-highlight {
    font-size: var(--heading-size);
    font-weight: bold;
    color: var(--text-dark);
    margin-bottom: var(--space-md);
}

.growth-info-box {
    background-color: var(--white);
    border: 1px solid var(--border-gray);
    padding: var(--space-sm);
    border-radius: 4px;
    margin-bottom: var(--space-sm);
}

.growth-info-box .label {
    color: var(--text-secondary);
    font-size: var(--label-size);
    margin-bottom: 4px;
}

.growth-info-box .value {
    font-size: var(--body-size);
    font-weight: 600;
    color: var(--text-dark);
}

.phase-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
}

.phase-info > div {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.phase-info .label {
    color: var(--text-secondary);
    font-size: 0.9em;
}

.phase-info .value {
    font-size: 1.2em;
    font-weight: bold;
    color: var(--primary-green);
}

.phase-controls {
    display: flex;
    gap: var(--space-md);
    margin-top: var(--space-md);
}

.btn-phase {
    flex: 1;
}

/* Phase Toggle Styles */
.phase-toggle-container {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    margin-top: var(--space-md);
}

.phase-label {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    cursor: pointer;
}

.phase-label input[type="checkbox"] {
    display: none;
}

.phase-toggle-labels {
    display: flex;
    gap: var(--space-xs);
    font-size: var(--label-size);
    color: var(--text-secondary);
}

.phase-toggle-labels .label-left {
    font-weight: 400;
}

.phase-toggle-labels .label-right {
    font-weight: 400;
}

.phase-label input:checked ~ .phase-toggle-labels .label-right {
    font-weight: 600;
    color: var(--text-dark);
}

.phase-label input:not(:checked) ~ .phase-toggle-labels .label-left {
    font-weight: 600;
    color: var(--text-dark);
}

/* Sensors */
.sensors-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
}

.sensor-card {
    background-color: var(--white);
    border: 1px solid var(--border-gray);
    border-radius: var(--space-xs);
    padding: var(--space-md);
    text-align: center;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    transition: transform 0.2s;
}

.sensor-card:hover {
    transform: translateY(-2px);
}

.sensor-icon-badge {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    margin: 0 auto var(--space-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    color: var(--white);
}

.sensor-icon-badge.temp-icon {
    background-color: #FF6B6B;
}

.sensor-icon-badge.humidity-icon {
    background-color: #4DABF7;
}

.sensor-icon-badge.light-icon {
    background-color: #FFD93D;
}

.sensor-icon-badge.water-icon {
    background-color: #4DABF7;
}

.sensor-name {
    font-size: var(--label-size);
    color: var(--text-secondary);
    margin-bottom: var(--space-xs);
}

.sensor-value {
    font-size: var(--value-size);
    font-weight: bold;
    color: var(--text-dark);
    margin-bottom: var(--space-sm);
    line-height: 1;
}

.sensor-target {
    font-size: 12px;
    color: var(--text-secondary);
    margin-top: var(--space-xs);
}

.sensor-status {
    font-size: 0.85em;
    color: var(--text-secondary);
    margin-top: var(--space-xs);
}

.sensor-status.error {
    color: var(--danger-color);
}

.sensor-status.stale {
    color: var(--warning-color);
}

/* Progress Bar */
.progress-bar-container {
    height: 8px;
    background-color: #F0F0F0;
    border-radius: 4px;
    margin: var(--space-xs) 0;
    overflow: hidden;
}

.progress-bar-fill {
    height: 100%;
    background-color: var(--primary-green);
    border-radius: 4px;
    transition: width 0.3s ease;
}

.progress-bar-fill.out-of-range {
    background-color: var(--danger-color);
}

.progress-bar-fill.warning {
    background-color: var(--warning-color);
}

/* Devices / System Controls */
.system-controls-panel {
    background-color: var(--white);
    border: 1px solid var(--border-gray);
    border-radius: var(--space-xs);
    padding: var(--space-lg);
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}

.device-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
}

.device-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 44px;
    padding: var(--space-xs) 0;
}

.device-name {
    font-size: var(--body-size);
    color: var(--text-dark);
    font-weight: 500;
}

.device-state {
    font-size: 1.5em;
    font-weight: bold;
    margin-bottom: 15px;
    color: var(--text-secondary);
}

.device-state.on {
    color: var(--primary-green);
}

.device-controls {
    display: flex;
    gap: 10px;
}

/* Legacy grid layout (if needed) */
.devices-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-md);
}

.device-card {
    background-color: var(--white);
    border: 1px solid var(--border-gray);
    border-radius: var(--space-xs);
    padding: var(--space-md);
    text-align: center;
}

/* Buttons */
.btn {
    flex: 1;
    padding: 10px 20px;
    border: none;
    border-radius: 5px;
    font-size: 1em;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s;
}

.btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

/* Toggle Switch */
.switch {
    position: relative;
    display: inline-block;
    width: 48px;
    height: 28px;
    min-width: 48px;
    min-height: 28px;
}

.switch input {
    opacity: 0;
    width: 0;
    height: 0;
}

.slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--border-gray);
    transition: 0.2s;
    border-radius: 28px;
}

.slider:before {
    position: absolute;
    content: "";
    height: 22px;
    width: 22px;
    left: 3px;
    bottom: 3px;
    background-color: white;
    transition: 0.2s;
    border-radius: 50%;
}

input:checked + .slider {
    background-color: var(--primary-green);
}

input:checked + .slider:before {
    transform: translateX(20px);
}

input:disabled + .slider {
    opacity: 0.5;
    cursor: not-allowed;
}

/* Alerts */
.alerts-section {
    background-color: var(--white);
    border-left: 4px solid var(--warning-color);
}

.alerts-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.alert-item {
    padding: 15px;
    background-color: var(--light-gray);
    border-radius: 5px;
    border-left: 3px solid var(--warning-color);
    color: var(--text-dark);
}

/* 1024x600 Viewport Optimization */
@media (max-width: 1024px) and (max-height: 600px) {
    :root {
        --space-lg: 20px;
        --space-md: 12px;
    }

    .sensor-card {
        padding: 12px;
    }

    .growth-panel {
        padding: 16px;
    }
}

/* Responsive */
@media (max-width: 1023px) {
    .sensors-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .panels-container {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 768px) {
    .header {
        flex-direction: column;
        gap: var(--space-sm);
        text-align: center;
    }

    .header-left {
        flex-direction: column;
    }

    .sensors-grid {
        grid-template-columns: 1fr;
    }

    .panels-container {
        grid-template-columns: 1fr;
    }

    .phase-controls {
        flex-direction: column;
    }

    .devices-grid {
        grid-template-columns: 1fr;
    }
}
