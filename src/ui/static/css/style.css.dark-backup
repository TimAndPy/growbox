/* GrowBox Control Panel Styles */

:root {
    --primary-color: #2ecc71;
    --secondary-color: #27ae60;
    --danger-color: #e74c3c;
    --warning-color: #f39c12;
    --bg-dark: #1a1a1a;
    --bg-card: #2c2c2c;
    --text-primary: #ffffff;
    --text-secondary: #b0b0b0;
    --border-color: #404040;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: var(--bg-dark);
    color: var(--text-primary);
    line-height: 1.6;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
}

/* Header */
.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    background-color: var(--bg-card);
    border-radius: 10px;
    margin-bottom: 30px;
}

.header h1 {
    font-size: 2em;
    color: var(--primary-color);
}

.connection-status {
    display: flex;
    align-items: center;
    gap: 10px;
}

.status-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: var(--danger-color);
    animation: pulse 2s infinite;
}

.status-dot.online {
    background-color: var(--primary-color);
    animation: none;
}

@keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
}

/* Section */
.section {
    background-color: var(--bg-card);
    border-radius: 10px;
    padding: 25px;
    margin-bottom: 25px;
}

.section h2 {
    font-size: 1.5em;
    margin-bottom: 20px;
    color: var(--primary-color);
    border-bottom: 2px solid var(--border-color);
    padding-bottom: 10px;
}

/* Growth Phase */
.phase-info {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 20px;
}

.phase-info > div {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.phase-info .label {
    color: var(--text-secondary);
    font-size: 0.9em;
}

.phase-info .value {
    font-size: 1.2em;
    font-weight: bold;
    color: var(--primary-color);
}

.phase-controls {
    display: flex;
    gap: 15px;
}

.btn-phase {
    flex: 1;
}

/* Sensors */
.sensors-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
}

.sensor-card {
    background-color: var(--bg-dark);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 20px;
    text-align: center;
    transition: transform 0.2s;
}

.sensor-card:hover {
    transform: translateY(-5px);
}

.sensor-icon {
    font-size: 3em;
    margin-bottom: 10px;
}

.sensor-name {
    font-size: 1em;
    color: var(--text-secondary);
    margin-bottom: 10px;
}

.sensor-value {
    font-size: 2em;
    font-weight: bold;
    color: var(--primary-color);
    margin-bottom: 5px;
}

.sensor-status {
    font-size: 0.85em;
    color: var(--text-secondary);
}

.sensor-status.error {
    color: var(--danger-color);
}

.sensor-status.stale {
    color: var(--warning-color);
}

/* Devices */
.auto-mode {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 20px;
    padding: 15px;
    background-color: var(--bg-dark);
    border-radius: 8px;
}

.auto-mode .label {
    font-size: 1.1em;
    font-weight: 500;
}

.devices-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 20px;
}

.device-card {
    background-color: var(--bg-dark);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 20px;
    text-align: center;
}

.device-name {
    font-size: 1.1em;
    margin-bottom: 10px;
    color: var(--text-primary);
}

.device-state {
    font-size: 1.5em;
    font-weight: bold;
    margin-bottom: 15px;
    color: var(--text-secondary);
}

.device-state.on {
    color: var(--primary-color);
}

.device-controls {
    display: flex;
    gap: 10px;
}

/* Buttons */
.btn {
    flex: 1;
    padding: 10px 20px;
    border: none;
    border-radius: 5px;
    font-size: 1em;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s;
}

.btn-on {
    background-color: var(--primary-color);
    color: white;
}

.btn-on:hover {
    background-color: var(--secondary-color);
}

.btn-off {
    background-color: var(--danger-color);
    color: white;
}

.btn-off:hover {
    background-color: #c0392b;
}

.btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

/* Toggle Switch */
.switch {
    position: relative;
    display: inline-block;
    width: 60px;
    height: 34px;
}

.switch input {
    opacity: 0;
    width: 0;
    height: 0;
}

.slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: #404040;
    transition: 0.4s;
    border-radius: 34px;
}

.slider:before {
    position: absolute;
    content: "";
    height: 26px;
    width: 26px;
    left: 4px;
    bottom: 4px;
    background-color: white;
    transition: 0.4s;
    border-radius: 50%;
}

input:checked + .slider {
    background-color: var(--primary-color);
}

input:checked + .slider:before {
    transform: translateX(26px);
}

/* Alerts */
.alerts-section {
    background-color: var(--bg-card);
    border-left: 4px solid var(--warning-color);
}

.alerts-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.alert-item {
    padding: 15px;
    background-color: var(--bg-dark);
    border-radius: 5px;
    border-left: 3px solid var(--warning-color);
    color: var(--text-primary);
}

/* Responsive */
@media (max-width: 768px) {
    .header {
        flex-direction: column;
        gap: 15px;
        text-align: center;
    }

    .phase-info {
        grid-template-columns: 1fr;
    }

    .phase-controls {
        flex-direction: column;
    }

    .sensors-grid,
    .devices-grid {
        grid-template-columns: 1fr;
    }
}
